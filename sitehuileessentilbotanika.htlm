<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BotaniKa - Huiles Essentielles</title>
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0; text-align: center; }
    h1 { color: #2d6a4f; margin-top: 50px; font-size: 36px; }
    .product { background-color: white; border-radius: 8px; padding: 30px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); max-width: 500px; margin: 30px auto; }
    img { max-width: 100%; border-radius: 8px; }
    .price { font-size: 24px; color: #2d6a4f; font-weight: bold; }
    p { color: #333; font-size: 16px; }
    button { padding: 12px 25px; background-color: #2ecc71; color: white; border: none; border-radius: 5px; font-size: 18px; cursor: pointer; transition: background-color 0.3s ease; }
    button:hover { background-color: #27ae60; }
    footer { font-size: 14px; color: #888; margin-top: 50px; }
  </style>
</head>
<body>
  <h1>Bienvenue sur BotaniKa</h1>
  <div class="product">
    <img src="https://via.placeholder.com/400x300?text=Huile+Essentielle" alt="Huile essentielle" />
    <h2>Huile de Lavande Bio</h2>
    <p>100% pure, idéale pour la relaxation et le bien-être. Apporte calme et sérénité à votre quotidien.</p>
    <p class="price">15€</p>
    <!-- Faux lien PayPal pour tester -->
    <a href="https://www.paypal.com/mep/dashboard" target="_blank">
      <button>Acheter maintenant</button>
    </a>
  </div>
  <footer>
    <p>&copy; 2025 BotaniKa - Huiles Essentielles | Livraison rapide & gratuite</p>
  </footer>
</body>
</html>
